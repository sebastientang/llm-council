{
  "name": "@sebastientang/llm-council",
  "version": "0.4.0",
  "description": "Multi-model deliberation engine for high-stakes decisions. Adversarial debate, anonymized peer review, structured synthesis.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "llm-council": "./bin/llm-council.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=true vitest run tests/integration",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "llm",
    "council",
    "deliberation",
    "multi-model",
    "decision-making",
    "adversarial",
    "peer-review",
    "ai"
  ],
  "author": "Sebastien Tang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastientang/llm-council.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "mitt": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
